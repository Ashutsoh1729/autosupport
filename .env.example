DATABASE_URL=postgresql://user:password@host:5432/db
BETTER_AUTH_SECRET=replace-with-a-random-secret
BETTER_AUTH_URL=http://localhost:3000

# Embeddings (Gemini via Vercel AI SDK)
GEMINI_API_KEY=replace-with-your-gemini-key
GOOGLE_API_KEY=replace-with-your-gemini-key
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Chat model for grounded answers (Vercel AI SDK)
GEMINI_CHAT_MODEL=gemini-2.5-flash
# Optional: route the chat model through OpenRouter (OpenAI-compatible) instead of Gemini
# OPENROUTER_API_KEY=replace-with-openrouter-key
# OPENROUTER_MODEL=anthropic/claude-sonnet-4
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Cloudflare R2 (file sources)
R2_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=replace-with-access-key
R2_SECRET_ACCESS_KEY=replace-with-secret-key
R2_BUCKET=replace-with-bucket-name

# Inngest (background ingestion)
INNGEST_EVENT_KEY=replace-with-event-key
INNGEST_SIGNING_KEY=replace-with-signing-key

# LiveKit Cloud (voice runtime) — free Build tier
LIVEKIT_URL=wss://<project>.livekit.cloud
LIVEKIT_API_KEY=replace-with-livekit-api-key
LIVEKIT_API_SECRET=replace-with-livekit-api-secret

# Deepgram (speech-to-text / text-to-speech for the voice worker)
DEEPGRAM_API_KEY=replace-with-deepgram-api-key
